# Copy this file to .env and fill in real values. Never commit .env.

APP_ENV=development

# Leave blank to use the default SQLite file (ecotrack.db in the project root).
DATABASE_URL=

# AI Resource Coach (n8n). Leave blank to use the built-in fallback coach.
N8N_WEBHOOK_URL=
N8N_SHARED_SECRET=
COACH_TIMEOUT_SECONDS=20

# Only needed if the frontend is served from a different origin.
ALLOWED_ORIGINS=